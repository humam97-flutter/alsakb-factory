# من Supabase: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# المفتاح المنشور (Publishable key، يبدأ بـ sb_publishable_)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# المفتاح السري (Secret key، يبدأ بـ sb_secret_): للسيرفر فقط، لإنشاء حسابات الموظفين
SUPABASE_SERVICE_ROLE_KEY=

# المرحلة السابعة (تنضاف بإعدادات Vercel فقط)
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
CRON_SECRET=
# اختياري: الدومين الخاص مثل https://erp.alsakb.iq
NEXT_PUBLIC_SITE_URL=
